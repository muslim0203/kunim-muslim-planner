<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase-0 minimal manifest. Deliberately does NOT declare (per CLAUDE.md /
  docs/plan.md policy):
    - android:name=".*AccessibilityService" (no AccessibilityService, ever)
    - android.permission.QUERY_ALL_PACKAGES
    - android.permission.SYSTEM_ALERT_WINDOW
    - android.permission.PACKAGE_USAGE_STATS (Phase 6 Digital Wellbeing,
      requested via a dedicated settings-redirect flow, not a manifest
      permission grant)
  minSdkVersion is set in android/app/build.gradle.kts (minSdk = 26), not
  here, per the modern Flutter Gradle template.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed for API calls (apps/api sync) and Quran audio streaming
         (Phase 3+). No other permission is requested in Phase 0. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Kunim"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Displays the launch theme while Flutter initializes, then
                 hands off to NormalTheme once the first frame is drawn. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Required by the Flutter engine (embedding v2 discovery). -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Android 11+ package visibility: KUNIM never needs to enumerate other
      installed apps (that would require QUERY_ALL_PACKAGES, which is
      forbidden). The single <queries> entry below only lets the OS resolve
      an implicit ACTION_MAIN/LAUNCHER intent (e.g. a future "open your
      default browser/calendar" affordance) without granting broad package
      visibility.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
