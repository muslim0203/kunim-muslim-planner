# Environment: dev | staging | prod
ENV=dev
# Verbose logging / debug tracebacks in error responses
DEBUG=true

# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://kunim:kunim@localhost:5432/kunim
# Redis connection
REDIS_URL=redis://localhost:6379/0

# JWT signing key: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENV=staging/prod the placeholder, an empty or a shorter value makes the
# API refuse to start; ENV=dev accepts the placeholder.
JWT_SECRET=change-me-in-production
# AES-256-GCM key for encrypted note columns (mood/sleep/health/family notes,
# later ai_messages/ai_memory): base64 of 32 random bytes. Generate with
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# The placeholder only works with ENV=dev (public dev key); staging/prod refuse to start.
FIELD_ENC_KEY=change-me-in-production-32-bytes!
# Key version stamped into every ciphertext (rotation = re-encryption migration)
FIELD_ENC_KEY_VERSION=1
# Access token lifetime, minutes
ACCESS_TOKEN_TTL_MIN=15
# Refresh token lifetime, days
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed CORS origins (empty = CORS middleware disabled)
CORS_ORIGINS=

# Sentry DSN (optional; leave unset to disable error reporting)
SENTRY_DSN=

# Mount SQLAdmin at /admin
ADMIN_ENABLED=false
