# Environment: dev | staging | prod
ENV=dev
# Verbose logging / debug tracebacks in error responses
DEBUG=true

# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://kunim:kunim@localhost:5432/kunim
# Redis connection
REDIS_URL=redis://localhost:6379/0

# JWT signing key - MUST be overridden in staging/prod
JWT_SECRET=change-me-in-production
# AES-256-GCM key (32 bayt) — mood/health/sleep note, ai_messages, ai_memory uchun
FIELD_ENC_KEY=change-me-in-production-32-bytes!
# Access token lifetime, minutes
ACCESS_TOKEN_TTL_MIN=15
# Refresh token lifetime, days
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed CORS origins (empty = CORS middleware disabled)
CORS_ORIGINS=

# Sentry DSN (optional; leave unset to disable error reporting)
SENTRY_DSN=

# Mount SQLAdmin at /admin
ADMIN_ENABLED=false
