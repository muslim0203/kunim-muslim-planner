# KUNIM — muhit o'zgaruvchilari namunasi.
#
# MUHIM: bu faylni nusxalab `.env` deb saqlang va haqiqiy qiymatlarni
# to'ldiring. `.env` fayli `.gitignore` da — u hech qachon commit qilinmaydi.
# Bu faylda (`.env.example`) hech qanday haqiqiy parol/kalit YO'Q — barchasi
# faqat namuna (placeholder) qiymatlar.
#
#   cp .env.example .env
#
# Quyidagi o'zgaruvchilar infra/docker-compose*.yml va apps/api tomonidan
# ishlatiladi.

# --- PostgreSQL (infra/docker-compose.yml: postgres xizmati) ---
# DB foydalanuvchi nomi
POSTGRES_USER=kunim
# DB paroli — devda ixtiyoriy, prod'da albatta kuchli qiymat bilan almashtiring
POSTGRES_PASSWORD=change-me
# DB nomi
POSTGRES_DB=kunim
# API/worker uchun to'liq ulanish satri (async driver, asyncpg)
DATABASE_URL=postgresql+asyncpg://kunim:change-me@postgres:5432/kunim

# --- Redis (infra/docker-compose.yml: redis xizmati) ---
# API/worker uchun Redis ulanish satri (cache + arq navbat backend)
REDIS_URL=redis://redis:6379/0

# --- Xavfsizlik ---
# JWT tokenlarni imzolash uchun maxfiy kalit — prod'da albatta almashtiring
JWT_SECRET=change-me-in-production
# Bazadagi maxfiy maydonlarni (masalan PII) shifrlash uchun kalit
FIELD_ENC_KEY=change-me-in-production

# --- Ilova muhiti ---
# dev | staging | prod
ENV=dev
# CORS uchun ruxsat etilgan originlar, vergul bilan ajratilgan (bo'sh = o'chirilgan)
CORS_ORIGINS=http://localhost:3000

# --- MinIO / S3 (infra/docker-compose.yml: minio, minio-init xizmatlari) ---
# MinIO admin foydalanuvchi nomi
MINIO_ROOT_USER=kunim
# MinIO admin paroli — devda ixtiyoriy, prod'da albatta kuchli qiymat bilan almashtiring
MINIO_ROOT_PASSWORD=change-me-minio
# Eksport fayllar uchun S3 bucket nomi (minio-init shu bucket'ni yaratadi)
S3_BUCKET=kunim-exports

# --- Prod deploy (infra/docker-compose.prod.yml, infra/Caddyfile) ---
# Caddy avtomatik TLS sertifikat olishi uchun domen nomi
DOMAIN=example.com

# --- Kuzatuv / monitoring (ixtiyoriy) ---
# Sentry loyihasi DSN manzili — bo'sh bo'lsa xatolik hisoboti o'chirilgan
SENTRY_DSN=

# --- AI provayderlari (RAG / kontent generatsiya, keyingi bosqichlar) ---
# Anthropic (Claude) API kaliti
ANTHROPIC_API_KEY=
# Voyage AI (embedding) API kaliti
VOYAGE_API_KEY=

# --- Push bildirishnomalar ---
# Firebase Cloud Messaging service-account JSON fayl yo'li (konteyner ichida)
FCM_CREDENTIALS_PATH=/run/secrets/fcm-service-account.json

# Google sign-in: comma-separated OAuth client ids whose ID tokens are
# accepted (the web client id used as the app's `serverClientId`, plus the
# iOS client id). Empty disables `/auth/google` (it answers 503).
GOOGLE_CLIENT_IDS=864078413890-el04gc5octqltk6cbtqiqfj85uhflita.apps.googleusercontent.com
